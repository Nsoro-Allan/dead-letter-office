{
  "version": "v1",
  "hooks": [
    {
      "name": "TypeScript Check on Component Save",
      "trigger": "PostFileSave",
      "matcher": "components/.*\\.tsx$",
      "action": {
        "type": "command",
        "command": "cd /run/media/nsoroallan/Content/Programming/Kiroween/haunted-portfolio && npx tsc --noEmit --pretty 2>&1 | head -20"
      },
      "timeout": 30
    }
  ]
}
